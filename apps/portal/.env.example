# Frontend-only by default. Keep demo mode for Milestone 1 deployment.
VITE_DATA_MODE=demo
VITE_PUBLIC_BASE=/

# Only after the backend owner verifies the V1 gateway on the hosting origin:
# VITE_DATA_MODE=api
# VITE_API_BASE_URL=/server/beauty_guild_api
# VITE_ENABLED_LEGACY_APIS=courses,address

# Enable only after Catalyst Authentication and SDK scripts work on hosting.
# Must be combined with VITE_DATA_MODE=api.
# VITE_CATALYST_AUTH=true

# No Zoho, Stripe, Catalyst or OAuth secret may appear in VITE_ variables.

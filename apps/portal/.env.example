# Milestone 2 remains frontend-only until real contracts and authenticated APIs are verified.
# Any value other than demo is labelled integration-pending, never activated automatically.
VITE_DATA_MODE=demo

# Use / when hosted at domain root; use /app/ if publishing under legacy Catalyst /app.
VITE_PUBLIC_BASE=/

# No actual draft routes or authentication credentials are configured here.
# Never put API secrets or Stripe secret keys in VITE_ variables.

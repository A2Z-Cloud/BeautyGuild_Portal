# Milestone 1 operates in visibly-labelled, fixture-only demonstration mode.
VITE_PORTAL_MODE=demo

# For hosting without SPA rewrite support, set to "hash".
# Default "browser" produces clean URLs and requires SPA fallback.
VITE_ROUTER_MODE=browser

# Set only if the site is hosted under a path such as /app/.
# VITE_PUBLIC_BASE=/app/

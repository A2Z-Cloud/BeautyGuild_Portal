// ============================================================================
// PATCH for Creator.process_membership_payment  (not a function on its own)
// Purpose : record the discounts used on a first payment.
//
// Paste this block AFTER Stage 3 (the CRM fulfilment, which ends with the insurance policy block that
// finishes `policy_id = policy_result.get("policy_id");`) and BEFORE Stage 4 (Books).
//
// It uses variables the function already has: metadata, contact_id, session_id, invoice_id, log_id.
// Both calls do nothing when no discount was applied, and both are safe to run again on a retry.
// The order matters: finish_discounts counts the rows that record_voucher_redemptions creates.
// ============================================================================

		//
		// ---- Stage 3b: discounts (referral code, voucher, staff waiver) ----
		// Record each redemption, then save the voucher usage count and mark any staff waiver Paid.
		// Both do nothing when no discount was applied, and both are safe to run again on a retry.
		redemption_result = thisapp.Creator.record_voucher_redemptions(metadata,contact_id,session_id,invoice_id,log_id.toString());
		finish_result = thisapp.Creator.finish_discounts(metadata,session_id);
		if(finish_result.get("problems").size() > 0)
		{
			info "Discount follow-ups had problems: " + finish_result.get("problems");
		}


map Vouchers.issue_gti_voucher(string contact_id, string membership_profile_id, string member_type, string term_start, string term_end, string source_invoice_id, string reason, bool pending_approval)
{
	// NOTE: Creates the member's personal £25 GTi voucher in the CRM module Discount_Voucher, once per
	// Contact per membership term. Safe to call again for the same term: it finds the existing voucher
	// and returns it. It never creates a second one, never edits an existing one, and never throws.
	//   contact_id             CRM Contact id (from the subscription snapshot)
	//   membership_profile_id  CRM Membership profile id (NOT the Deal), may be "" if not known yet
	//   member_type            "Associate", "International" or "Full" (Full covers Non-Salon and Salon)
	//   term_start             first day of the NEW membership term, yyyy-MM-dd. For an early renewal this is the
	//                          renewal date (the day after the old expiry), NOT the processing date
	//   term_end               membership expiry AFTER this payment, as yyyy-MM-dd. The term is identified by it.
	//   source_invoice_id      Stripe invoice id, stored on the voucher so staff can trace it
	//   reason                 "new", "renewal" or "upgrade" (for the log only)
	//   pending_approval       false (the default setting): the voucher is created Active. true: it is created with
	//                          Active = false and a CRM approval step activates it
	//   Valid_To is always the membership's end date (end of that day, UK time) and Expires_With_Membership is true: the
	//   voucher ends with the membership. sync_voucher_end_date.deluge moves Valid_To if that date later changes.
	// Returns {"status": "created" | "exists" | "skipped" | "error", "voucher_id", "code", "message"}.
	//
	// CRM names are the real Discount_Voucher API names. Voucher_Code already exists (text, 255) but the CRM does NOT
	// enforce that it is unique or case-insensitive, so this function checks. Voucher_Key is NEW: unique, immutable text.
	// Name is an Auto Number: never write to it. Applicable_Items is left empty (not used by the £25 voucher).
	// Source_Invoice holds the Stripe invoice id (in_...) as text for now. Which CRM invoice module it may become a
	// lookup to is undecided, so the field name is set once here.
	source_invoice_field = "Source_Invoice";
	crm_connection = "zoho_crm_connection";
	module_name = "Discount_Voucher";
	max_code_attempts = 5;
	try 
	{
		if(contact_id == null || contact_id.trim() == "")
		{
			return {"status":"error","message":"No Contact id, so no voucher can be issued."};
		}
		if(term_start == null || term_start.trim() == "")
		{
			return {"status":"error","message":"No term start date, so the voucher has no valid-from date."};
		}
		if(term_end == null || term_end.trim() == "")
		{
			return {"status":"error","message":"No membership expiry, so the voucher has no valid-to date."};
		}
		if(member_type == null || member_type.trim() == "")
		{
			return {"status":"error","message":"No member type (Associate, International or Full)."};
		}
		// One voucher per Contact per term. The key is the idempotency key and must be a UNIQUE field in the CRM.
		voucher_key = contact_id.trim() + "-" + term_end.trim().replaceAll("-","");
		existing = zoho.crm.searchRecords(module_name,"(Voucher_Key:equals:" + voucher_key + ")",1,5,crm_connection);
		if(existing.size() > 0)
		{
			found = existing.get(0);
			info "Voucher already exists for key " + voucher_key + ": " + found.get("id");
			return {"status":"exists","voucher_id":found.get("id"),"code":found.get("Voucher_Code"),"message":"Already issued for this term."};
		}
		// Skip when the Contact already holds an active, unused personal voucher that is valid on the new term's start
		// (for example an Associate upgrading to Full mid-term). An early renewal does NOT skip: the old voucher ends
		// the day before the new term starts, so the new voucher is still issued, starting on the renewal date.
		// This replaces the manual decline in Enki today.
		start_number = term_start.trim().replaceAll("-","").toLong();
		held = zoho.crm.searchRecords(module_name,"((Assigned_Contact:equals:" + contact_id.trim() + ")and(Voucher_Type:equals:Personal £25 GTI)and(Active:equals:true))",1,50,crm_connection);
		for each  held_voucher in held
		{
			held_from = ifnull(held_voucher.get("Valid_From"),"").toString();
			held_to = ifnull(held_voucher.get("Valid_To"),"").toString();
			held_used = ifnull(held_voucher.get("Current_Usage_Count"),0).toLong() >= ifnull(held_voucher.get("Maximum_Total_Uses"),1).toLong();
			if(held_used == false && held_from.length() >= 10 && held_to.length() >= 10)
			{
				from_number = held_from.subString(0,10).replaceAll("-","").toLong();
				to_number = held_to.subString(0,10).replaceAll("-","").toLong();
				if(from_number <= start_number && to_number >= start_number)
				{
					info "Skipped: Contact " + contact_id + " already holds active voucher " + held_voucher.get("id") + " covering " + term_start;
					return {"status":"skipped","voucher_id":held_voucher.get("id"),"code":held_voucher.get("Voucher_Code"),"message":"The Contact already has an active unused voucher covering the new term start."};
				}
			}
		}
		// First write wins. If two calls race, the unique key makes the second create fail, and the
		// error branch below re-reads and returns the winner instead of reporting a failure.
		// A clash on the code is a reason to try the next code, never to overwrite or reuse an existing voucher.
		for each  attempt in {1,2,3,4,5}
		{
			// Codes are always upper case. Check both cases in case the CRM search is case-sensitive.
			code = thisapp.Vouchers.generate_voucher_code(voucher_key,attempt).toUpperCase();
			clash = zoho.crm.searchRecords(module_name,"(Voucher_Code:equals:" + code + ")",1,1,crm_connection);
			clash_lower = zoho.crm.searchRecords(module_name,"(Voucher_Code:equals:" + code.toLowerCase() + ")",1,1,crm_connection);
			if(clash.size() == 0 && clash_lower.size() == 0)
			{
				record = Map();
				record.put("Voucher_Code",code);
				record.put("Voucher_Type","Personal £25 GTI");
				record.put("Discount_Method","Fixed Amount");
				record.put("Discount_Value",25);
				record.put("Applies_To_Type",{"Courses"});
				record.put("Assigned_Contact",contact_id.trim());
				if(membership_profile_id != null && membership_profile_id.trim() != "")
				{
					record.put("Assigned_Member_Profile",membership_profile_id.trim());
				}
				record.put("Eligible_Member_Types",{member_type.trim()});
				record.put("Maximum_Total_Uses",1);
				record.put("One_Use_Per_Person",true);
				record.put("Expires_With_Membership",true);
				// DateTime fields, UK time: the term's first moment to the end of its last day (the Guild's rule).
				record.put("Valid_From",term_start.trim() + "T00:00:00" + thisapp.Vouchers.uk_offset(term_start,"start"));
				record.put("Valid_To",term_end.trim() + "T23:59:59" + thisapp.Vouchers.uk_offset(term_end,"end"));
				record.put("Active",(pending_approval == false));
				record.put("Voucher_Key",voucher_key);
				record.put(source_invoice_field,ifnull(source_invoice_id,""));
				// Current_Usage_Count is left alone: GTi redemption increments it, not this process.
				created = zoho.crm.createRecord(module_name,record,Map(),crm_connection);
				if(created.get("id") != null)
				{
					// Voucher_Code is not unique in the CRM, so confirm no other record took the same code in the
					// meantime. If one did, void OUR new record (never the other) and try the next code.
					same_code = zoho.crm.searchRecords(module_name,"(Voucher_Code:equals:" + code + ")",1,5,crm_connection);
					if(same_code.size() > 1)
					{
						undo = Map();
						undo.put("Active",false);
						undo.put("Void_Reason","Code clash at creation, replaced by a new code.");
						zoho.crm.updateRecord(module_name,created.get("id"),undo,Map(),crm_connection);
						info "Code clash for " + code + ": voided " + created.get("id") + " and retrying.";
						continue;
					}
					info "Issued " + reason + " voucher " + code + " for Contact " + contact_id + " until " + term_end + " (invoice " + source_invoice_id + ")";
					return {"status":"created","voucher_id":created.get("id"),"code":code,"message":"Issued (" + reason + ")" + if(pending_approval,", pending CRM approval","") + "."};
				}
				// Not created. If the key now exists, another call won the race: return that one.
				raced = zoho.crm.searchRecords(module_name,"(Voucher_Key:equals:" + voucher_key + ")",1,5,crm_connection);
				if(raced.size() > 0)
				{
					return {"status":"exists","voucher_id":raced.get(0).get("id"),"code":raced.get(0).get("Voucher_Code"),"message":"Issued by a concurrent call."};
				}
				// Refused for another reason, possibly a clash on a code taken since the check: log it and try a new code.
				info "CRM refused the voucher with code " + code + ": " + created.toString();
			}
		}
		return {"status":"error","message":"No voucher created in " + max_code_attempts + " attempts: every code clashed or the CRM refused it (see the log)."};
	}
	catch (e)
	{
		return {"status":"error","message":"Exception: " + e};
	}
}

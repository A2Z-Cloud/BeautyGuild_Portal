map Vouchers.issue_gti_voucher(string contact_id, string membership_id, string term_end, string source_invoice_id, string reason)
{
	// NOTE: Creates the member's individual £25 GTi voucher in the CRM module Discount_Voucher, once per
	// Contact per membership term. Safe to call again for the same term: it finds the existing voucher
	// and returns it. It never creates a second one, never edits an existing one, and never throws.
	//   contact_id         CRM Contact id (from the subscription snapshot)
	//   membership_id      CRM Deal id of the membership, may be "" if not known yet
	//   term_end           membership expiry AFTER this payment, as yyyy-MM-dd. The term is identified by it.
	//   source_invoice_id  Stripe invoice id, stored on the voucher so staff can trace it
	//   reason             "new", "renewal" or "upgrade" (for the log only)
	// Returns {"status": "created" | "exists" | "error" | "skipped", "voucher_id", "code", "message"}.
	//
	// ALL CRM NAMES ARE UNVERIFIED. They are listed once here. Check them against
	// GET /portal/diagnostics/fields?module=Discount_Voucher (see vouchers-phase-4-gti-voucher.md, section 2)
	// and change only this block.
	crm_connection = "zoho_crm_connection";
	module_name = "Discount_Voucher";
	f_code = "Voucher_Code";
	f_contact = "Contact";
	f_membership = "Membership";
	f_value = "Value";
	f_valid_until = "Valid_Until";
	f_status = "Status";
	f_key = "Voucher_Key";
	f_source = "Source_Invoice";
	status_active = "Active";
	voucher_value = 25;
	max_code_attempts = 5;
	try 
	{
		if(contact_id == null || contact_id.trim() == "")
		{
			return {"status":"error","message":"No Contact id, so no voucher can be issued."};
		}
		if(term_end == null || term_end.trim() == "")
		{
			return {"status":"error","message":"No membership expiry, so the voucher has no valid-until date."};
		}
		// One voucher per Contact per term. The key is the idempotency key and must be a UNIQUE field in the CRM.
		term_compact = term_end.trim().replaceAll("-","");
		voucher_key = contact_id.trim() + "-" + term_compact;
		existing = zoho.crm.searchRecords(module_name,"(" + f_key + ":equals:" + voucher_key + ")",1,5,crm_connection);
		if(existing.size() > 0)
		{
			found = existing.get(0);
			info "Voucher already exists for key " + voucher_key + ": " + found.get("id");
			return {"status":"exists","voucher_id":found.get("id"),"code":found.get(f_code),"message":"Already issued for this term."};
		}
		// First write wins. If two calls race, the unique key makes the second create fail, and the
		// error branch below re-reads and returns the winner instead of reporting a failure.
		attempts = {1,2,3,4,5};
		for each  attempt in attempts
		{
			code = thisapp.Vouchers.generate_voucher_code(voucher_key,attempt);
			clash = zoho.crm.searchRecords(module_name,"(" + f_code + ":equals:" + code + ")",1,1,crm_connection);
			if(clash.size() == 0)
			{
				record = Map();
				record.put(f_code,code);
				record.put(f_contact,contact_id.trim());
				if(membership_id != null && membership_id.trim() != "")
				{
					record.put(f_membership,membership_id.trim());
				}
				record.put(f_value,voucher_value);
				record.put(f_valid_until,term_end.trim());
				record.put(f_status,status_active);
				record.put(f_key,voucher_key);
				record.put(f_source,ifnull(source_invoice_id,""));
				created = zoho.crm.createRecord(module_name,record,Map(),crm_connection);
				if(created.get("id") != null)
				{
					info "Issued " + reason + " voucher " + code + " for Contact " + contact_id + " until " + term_end + " (invoice " + source_invoice_id + ")";
					return {"status":"created","voucher_id":created.get("id"),"code":code,"message":"Issued (" + reason + ")."};
				}
				// Not created. If the key now exists, another call won the race: return that one.
				raced = zoho.crm.searchRecords(module_name,"(" + f_key + ":equals:" + voucher_key + ")",1,5,crm_connection);
				if(raced.size() > 0)
				{
					return {"status":"exists","voucher_id":raced.get(0).get("id"),"code":raced.get(0).get(f_code),"message":"Issued by a concurrent call."};
				}
				return {"status":"error","message":"CRM refused the voucher. Response: " + created.toString()};
			}
		}
		return {"status":"error","message":"Could not find an unused code in " + max_code_attempts + " attempts."};
	}
	catch (e)
	{
		return {"status":"error","message":"Exception: " + e};
	}
}
